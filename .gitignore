# ===== 构建产物 =====
build
.gradle
.gradle-registry
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# 本地 Gradle 家目录 / 守护进程缓存的几种历史写法（都是本机缓存，不入库）
.gradle-home
.gradle-home-*
.userhome
.userhome-*

# 构建完成的模组包：各节点的 versions/<版本>/build/libs/ 才是权威产物，
# 根目录 lib/ 只是本地收集处；libs/ 里只保留第三方编译依赖
/lib/
!libs/Registrate-MC1.21-1.3.0+67.jar
!libs/flywheel-neoforge-1.21.1-1.0.6.jar
!libs/ponder-neoforge-1.0.82+mc1.21.1.jar

# ===== 运行 / 测试 =====
run
runs
run-data
# 启动 Minecraft 时记录的日志（约定：所有日志统一放这里，只保留占位文件）
logs/*
!logs/README.md

# ===== 开发临时 / 工作目录（不入库，需要时本地准备或重新生成）=====
.tmp/
临时素材/
结构NBT/
repo/

# ===== 杂项 =====
*.log
hs_err_pid*.log
*.bak
*.tmp
.DS_Store
Thumbs.db
Desktop.ini
__pycache__/
*.pyc

# ===== IDE =====
bin
*.launch
.settings
.metadata
.classpath
.project
eclipse
out
*.ipr
*.iws
*.iml
.idea
.vscode/

# 开发辅助脚本（素材 / 模型 / 结构生成、游戏辅助）：只在本机保留，不入库
/tools/
# 个人设计/审计文档：只在本机留着，不入库
/docs/
